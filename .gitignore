# The sample pack contains real personal and company identifiers. Never commit it.
samples/response/
samples/rfq/
documents/
out/
.cache/
__pycache__/

# saved reports contain unredacted page images and personal details
tests/fixtures/baseline/
tests/fixtures/v2/*.pdf

# local config and environments
.env
.venv/
.DS_Store

# pilot access codes and usage (hashes and fingerprints only - codes themselves are never stored).
# pilot.db itself IS committed on purpose: Streamlit Community Cloud wipes local disk on every redeploy,
# so this is how the pilot codes survive a redeploy at all. Everything else here stays out of git.
pilot/*
!pilot/pilot.db
