# Copy to .env and fill in (needs python-dotenv, in requirements-dev.txt). Real environment variables win over
# this file, so `export`-ing by hand still works without it. Never commit .env - your key goes here, not in any
# file that's committed, and the app never prints or logs it.

# MODEL_PROVIDER picks which block below is read: "meta" (default - leave unset or set explicitly) or
# "openrouter" (the switchable fallback). Only one provider's block needs values filled in at a time.
# MODEL_PROVIDER=meta

# ---- Meta Model API, Muse Spark. Base URL, model id, pricing and request shape confirmed against Meta's
# own docs (dev.meta.ai/docs) on 2026-10-26. One model, Muse Spark, for both roles: it reads the RFQ/spec
# (text) and the scanned pages (handwriting, ticks, dates, stamps, signatures - multimodal). Same base URL
# and key for both on purpose; there is no separate TENDERLENS_VISION_* to set under this provider. ----
META_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
META_API_KEY=
# Page images ARE sent to Meta's Model API (a service outside South Africa) once this is set - see README
# "Privacy". Standard mode, not Contributor mode: Contributor mode is cheaper but lets Meta train future
# models on your content, which tender documents should not opt into without a separate decision to do so.

# Price per million tokens (US$), input/output - Meta's Standard-mode pricing as published on
# dev.meta.ai/docs/pricing-rate-limits on 2026-10-26. Check that page yourself before relying on this;
# prices change. Uncomment to see an estimated cost alongside the token totals; otherwise only the token
# counts are shown.
# TENDERLENS_LLM_PRICE_IN=1.25
# TENDERLENS_LLM_PRICE_OUT=4.25
# TENDERLENS_VISION_PRICE_IN=1.25
# TENDERLENS_VISION_PRICE_OUT=4.25

# ---- OpenRouter, OpenAI-compatible - the switchable fallback (set MODEL_PROVIDER=openrouter above to use
# this block instead). Base URL, model id and auth confirmed against OpenRouter's own live model listing
# (openrouter.ai/api/v1/models). ----
# One model, Llama 4 Scout, for both roles: it reads the RFQ/spec (text) and the scanned pages
# (handwriting, ticks, dates, stamps, signatures - multimodal; OpenRouter lists this model's
# input_modalities as text+image). Same base URL and key for both on purpose.
TENDERLENS_LLM_BASE_URL=https://openrouter.ai/api/v1
TENDERLENS_LLM_MODEL=meta-llama/llama-4-scout
TENDERLENS_LLM_API_KEY=

TENDERLENS_VISION_BASE_URL=https://openrouter.ai/api/v1
TENDERLENS_VISION_MODEL=meta-llama/llama-4-scout
TENDERLENS_VISION_API_KEY=
# Page images ARE sent to OpenRouter (a service outside South Africa) once this is set - see README "Privacy".

# Price per million tokens (US$), input/output, for the OpenRouter block above - nothing here is invented;
# this is what OpenRouter's own model listing showed when last checked (2026-10-18), default routing (not a
# specific upstream provider pin). Check openrouter.ai/meta-llama/llama-4-scout yourself before relying on
# this: prices change, and OpenRouter can route the same model id to different upstream providers/prices.
# TENDERLENS_LLM_PRICE_IN=0.10
# TENDERLENS_LLM_PRICE_OUT=0.30
# TENDERLENS_VISION_PRICE_IN=0.10
# TENDERLENS_VISION_PRICE_OUT=0.30

# Seconds per call (default 300). Shared by whichever provider is active.
TENDERLENS_LLM_TIMEOUT=300
# JSON mode (shared by whichever provider is active - not provider-specific, so flip this when you switch
# MODEL_PROVIDER): 1 (default) asks the server for strict JSON via response_format, matching Meta's Chat
# Completions docs. Required OFF (0) specifically for OpenRouter + Llama 4 Scout as of 2026-10-18: most of
# that model's non-BYOK endpoints don't support response_format - without turning this off, OpenRouter's
# routing filters down to a Google Vertex endpoint that needs a separate Google key nobody here has. Leave
# at 1 (or unset) for the Meta provider above.
# TENDERLENS_LLM_JSON_MODE=0   # uncomment only when MODEL_PROVIDER=openrouter

# ---- Local alternative: Ollama on your own laptop (nothing leaves the machine, but see OLLAMA.md for a known
# Ollama bug with llama3.2-vision, and that Llama 4 Scout above is too large to run on a laptop). Uncomment,
# set MODEL_PROVIDER=openrouter above, and fill in instead of the OpenRouter block above; see OLLAMA.md for
# setup.
# TENDERLENS_LLM_BASE_URL=http://localhost:11434/v1
# TENDERLENS_LLM_MODEL=llama3.2:3b
# TENDERLENS_VISION_BASE_URL=http://localhost:11434/v1
# TENDERLENS_VISION_MODEL=llama3.2-vision

# ---- Pilot access (off by default; see README "Pilot mode") ----
# TENDERLENS_PILOT=1
