# Copy to .env and fill in (needs python-dotenv, in requirements-dev.txt). Real environment variables win over
# this file, so `export`-ing by hand still works without it. Never commit .env - your key goes here, not in any
# file that's committed, and the app never prints or logs it.

# ---- OpenRouter, OpenAI-compatible. Base URL, model id and auth confirmed against OpenRouter's own live
# model listing (openrouter.ai/api/v1/models). ----
# One model, Llama 4 Scout, for both roles: it reads the RFQ/spec (text) and the scanned pages
# (handwriting, ticks, dates, stamps, signatures - multimodal; OpenRouter lists this model's
# input_modalities as text+image). Same base URL and key for both on purpose.
TENDERLENS_LLM_BASE_URL=https://openrouter.ai/api/v1
TENDERLENS_LLM_MODEL=meta-llama/llama-4-scout
TENDERLENS_LLM_API_KEY=

TENDERLENS_VISION_BASE_URL=https://openrouter.ai/api/v1
TENDERLENS_VISION_MODEL=meta-llama/llama-4-scout
TENDERLENS_VISION_API_KEY=
# Page images ARE sent to OpenRouter (a service outside South Africa) once this is set - see README "Privacy".

# Price per million tokens (US$), input/output. Unset by default - nothing here is invented; this is what
# OpenRouter's own model listing showed when last checked (2026-10-18), default routing (not a specific
# upstream provider pin). Check openrouter.ai/meta-llama/llama-4-scout yourself before relying on this:
# prices change, and OpenRouter can route the same model id to different upstream providers/prices.
# Uncomment to see an estimated cost alongside the token totals; otherwise only the token counts are shown.
# TENDERLENS_LLM_PRICE_IN=0.10
# TENDERLENS_LLM_PRICE_OUT=0.30
# TENDERLENS_VISION_PRICE_IN=0.10
# TENDERLENS_VISION_PRICE_OUT=0.30

# Seconds per call (default 300).
TENDERLENS_LLM_TIMEOUT=300
# Required with OpenRouter + Llama 4 Scout as of 2026-10-18: most of this model's non-BYOK endpoints don't
# support structured JSON output (response_format) - without this, OpenRouter's routing filters down to a
# Google Vertex endpoint that needs a separate Google key nobody here has. The model still replies with
# clean JSON when the prompt just asks for it (parsed loosely, not enforced server-side).
TENDERLENS_LLM_JSON_MODE=0

# ---- Local alternative: Ollama on your own laptop (nothing leaves the machine, but see OLLAMA.md for a known
# Ollama bug with llama3.2-vision, and that Llama 4 Scout above is too large to run on a laptop). Uncomment and
# fill in instead of the OpenRouter block above; see OLLAMA.md for setup.
# TENDERLENS_LLM_BASE_URL=http://localhost:11434/v1
# TENDERLENS_LLM_MODEL=llama3.2:3b
# TENDERLENS_VISION_BASE_URL=http://localhost:11434/v1
# TENDERLENS_VISION_MODEL=llama3.2-vision

# ---- Pilot access (off by default; see README "Pilot mode") ----
# TENDERLENS_PILOT=1
