# Copy to .env and fill in (needs python-dotenv, in requirements-dev.txt). Real environment variables win over
# this file, so `export`-ing by hand still works without it. Never commit .env - your key goes here, not in any
# file that's committed, and the app never prints or logs it.

# ---- Meta Model API, Muse Spark - TenderLens's only hosted model provider. Base URL, model id, pricing and
# request shape confirmed against Meta's own docs (dev.meta.ai/docs) on 2026-10-26. One model, Muse Spark,
# for both roles: it reads the RFQ/spec (text) and the scanned pages (handwriting, ticks, dates, stamps,
# signatures - multimodal). Same base URL and key for both on purpose; there is no separate META_VISION_* to
# set here unless you want a different model for vision (see the Ollama block below for when you would). ----
META_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
META_API_KEY=
# Page images ARE sent to Meta's Model API (a service outside South Africa) once this is set - see README
# "Privacy". Standard mode, not Contributor mode: Contributor mode is cheaper but lets Meta train future
# models on your content, which tender documents should not opt into without a separate decision to do so.

# Price per million tokens (US$), input/output - Meta's Standard-mode pricing as published on
# dev.meta.ai/docs/pricing-rate-limits on 2026-10-26. Check that page yourself before relying on this;
# prices change. Uncomment to see an estimated cost alongside the token totals; otherwise only the token
# counts are shown.
# TENDERLENS_LLM_PRICE_IN=1.25
# TENDERLENS_LLM_PRICE_OUT=4.25
# TENDERLENS_VISION_PRICE_IN=1.25
# TENDERLENS_VISION_PRICE_OUT=4.25

# Seconds per call (default 300).
TENDERLENS_LLM_TIMEOUT=300
# 1 (default) asks the server for strict JSON via response_format, matching Meta's Chat Completions docs.
# Leave at 1 (or unset) unless a future endpoint specifically needs it off.
# TENDERLENS_LLM_JSON_MODE=0

# ---- Local alternative: Ollama on your own laptop (nothing leaves the machine, no API key needed - but see
# OLLAMA.md for a known Ollama bug with llama3.2-vision). Uncomment and fill in instead of the Meta block
# above. A local setup typically needs a different, smaller text model from the vision one, so this uses the
# separate META_VISION_* vars (same client code, just a second set of credentials - see llm.py). ----
# META_API_BASE=http://localhost:11434/v1
# MUSE_MODEL=llama3.2:3b
# META_VISION_BASE=http://localhost:11434/v1
# MUSE_VISION_MODEL=llama3.2-vision

# ---- Pilot access (off by default; see README "Pilot mode") ----
# TENDERLENS_PILOT=1

# ---- Large files: browser-to-bucket uploads (off unless GCS_BUCKET is set; see tenderlens/storage.py,
# jobs.py, vision_cache.py). Leave this whole block commented out to keep the existing small-file
# st.file_uploader path - that is the default, and nothing here changes it. ----
# GCS_BUCKET=                      # the one private bucket uploads go to - see README "Hosting on Google
#                                   # Cloud Run" for the gcloud commands to create it
# GCS_REGION=africa-south1         # Johannesburg - same region as the Cloud Run service itself
# MAX_UPLOAD_MB=300                # per file (the tender document and the response pack each get this)
# UPLOAD_RETENTION_DAYS=7          # a bucket lifecycle rule deletes objects after this long (see deploy notes)
# SIGNING_SERVICE_ACCOUNT=         # only needed if you switch to fully-signed URLs instead of the
#                                   # server-initiated resumable sessions this uses by default - see
#                                   # storage.py's module docstring for why that's not needed today
# MAX_STORED_MB_PER_USER=1500      # proposed default: 5 packs' worth (2 files x 300MB x ~2.5 safety margin)
#                                   # of simultaneous storage before a pilot code is refused a new upload -
#                                   # not yet enforced in code; a per-user quota needs the pilot code
#                                   # threaded through the upload path, which this task did not build
# MAX_UPLOADS_PER_DAY=10           # proposed default, matching the "10 packs/month" planning figure with
#                                   # headroom for retries - also not yet enforced; see Step 8's own report
