# Copy to .env and fill in (needs python-dotenv, in requirements-dev.txt). Real environment variables win over
# this file, so `export`-ing by hand still works without it. Never commit .env - your key goes here, not in any
# file that's committed, and the app never prints or logs it.

# ---- DeepInfra, OpenAI-compatible. Base URL and auth confirmed against DeepInfra's own docs. ----
# One model, Llama 4 Scout, for both roles: it reads the RFQ/spec (text) and the scanned pages
# (handwriting, ticks, dates, stamps, signatures - multimodal). Same base URL and key for both on purpose.
TENDERLENS_LLM_BASE_URL=https://api.deepinfra.com/v1/openai
TENDERLENS_LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
TENDERLENS_LLM_API_KEY=

TENDERLENS_VISION_BASE_URL=https://api.deepinfra.com/v1/openai
TENDERLENS_VISION_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
TENDERLENS_VISION_API_KEY=
# Page images ARE sent to DeepInfra (a service outside South Africa) once this is set - see README "Privacy".

# Price per million tokens (US$), input/output. Unset by default - nothing here is invented; this is what
# DeepInfra's own Llama 4 Scout page showed when last checked (2026-10-15), default tier (not Priority/Flex).
# Check deepinfra.com/meta-llama/Llama-4-Scout-17B-16E-Instruct yourself before relying on this: prices change.
# Uncomment to see an estimated cost alongside the token totals; otherwise only the token counts are shown.
# TENDERLENS_LLM_PRICE_IN=0.10
# TENDERLENS_LLM_PRICE_OUT=0.30
# TENDERLENS_VISION_PRICE_IN=0.10
# TENDERLENS_VISION_PRICE_OUT=0.30

# Seconds per call (default 300).
TENDERLENS_LLM_TIMEOUT=300
# TENDERLENS_LLM_JSON_MODE=0   # set only if your endpoint rejects response_format

# ---- Local alternative: Ollama on your own laptop (nothing leaves the machine, but see OLLAMA.md for a known
# Ollama bug with llama3.2-vision, and that Llama 4 Scout above is too large to run on a laptop). Uncomment and
# fill in instead of the DeepInfra block above; see OLLAMA.md for setup.
# TENDERLENS_LLM_BASE_URL=http://localhost:11434/v1
# TENDERLENS_LLM_MODEL=llama3.2:3b
# TENDERLENS_VISION_BASE_URL=http://localhost:11434/v1
# TENDERLENS_VISION_MODEL=llama3.2-vision

# ---- Pilot access (off by default; see README "Pilot mode") ----
# TENDERLENS_PILOT=1
