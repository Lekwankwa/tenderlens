# Copy to .env and fill in (needs python-dotenv, in requirements-dev.txt). Real environment variables win over
# this file, so `export`-ing by hand (see OLLAMA.md) still works without it. Never commit .env.

# ---- Text model: reads the RFQ email and spec (no personal data). ----
# Local Ollama: a plain (non-vision) model. llama3.2-vision's architecture ("mllama") is broken in several
# recent Ollama releases (github.com/ollama/ollama/issues/16490) - a separate text model sidesteps that bug
# entirely for this step, and is lighter to run.
TENDERLENS_LLM_BASE_URL=http://localhost:11434/v1
TENDERLENS_LLM_MODEL=llama3.2:3b
TENDERLENS_LLM_API_KEY=
# Hosted alternative (e.g. Groq free tier): set the base URL, a current model name, and a key.
# TENDERLENS_LLM_BASE_URL=https://api.groq.com/openai/v1
# TENDERLENS_LLM_MODEL=llama-3.3-70b-versatile
# TENDERLENS_LLM_API_KEY=

# ---- Vision model: reads handwriting, ticks, dates, stamps and signatures on the scanned forms. ----
# Local Ollama keeps page images on this machine. Leave these three unset to reuse the text model instead
# (it must then be a vision-capable one).
TENDERLENS_VISION_BASE_URL=http://localhost:11434/v1
TENDERLENS_VISION_MODEL=llama3.2-vision
TENDERLENS_VISION_API_KEY=

# Seconds per call (default 300). Local CPU inference is slow, especially the first call after a cold start.
TENDERLENS_LLM_TIMEOUT=600
# TENDERLENS_LLM_JSON_MODE=0   # set only if your endpoint rejects response_format
